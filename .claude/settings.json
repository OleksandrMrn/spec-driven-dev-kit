{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current *)",
      "Bash(git check-ignore *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard*)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend*)",
      "Bash(git rebase *)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -d*)",
      "Bash(git branch * -D*)",
      "Bash(git branch *--delete*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  }
}
